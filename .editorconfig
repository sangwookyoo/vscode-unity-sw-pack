root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml}]
indent_size = 2

[*.md]
# Trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[{package.json,package-lock.json}]
indent_size = 2

[*.{unity,prefab,asset,meta}]
# Unity serializes YAML with 2-space indentation; never reformat fixtures.
indent_size = 2
trim_trailing_whitespace = false
