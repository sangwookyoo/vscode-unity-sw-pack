{
  "name": "unity-sw-pack",
  "displayName": "%ext.displayName%",
  "description": "%ext.description%",
  "version": "2.1.0",
  "publisher": "SangwookYoo",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sangwookyoo/vscode-unity-sw-pack.git"
  },
  "bugs": {
    "url": "https://github.com/sangwookyoo/vscode-unity-sw-pack/issues"
  },
  "engines": {
    "vscode": "^1.76.0"
  },
  "categories": [
    "Snippets",
    "Programming Languages",
    "Themes",
    "Linters"
  ],
  "keywords": [
    "unity",
    "unity3d",
    "unity6",
    "c#",
    "csharp",
    "monobehaviour",
    "unityevent",
    "prefab",
    "scene"
  ],
  "activationEvents": [
    "onLanguage:csharp"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "unitySWpack.unityEventMessage": {
          "type": "boolean",
          "default": true,
          "description": "%config.unityEventMessage%"
        },
        "unitySWpack.usageScenePrefab": {
          "type": "boolean",
          "default": true,
          "description": "%config.usageScenePrefab%"
        },
        "unitySWpack.unityMessageHover": {
          "type": "boolean",
          "default": true,
          "description": "%config.unityMessageHover%"
        },
        "unitySWpack.typeToggle": {
          "type": "boolean",
          "default": true,
          "description": "%config.typeToggle%"
        },
        "unitySWpack.metaFileSync": {
          "type": "boolean",
          "default": true,
          "description": "%config.metaFileSync%"
        },
        "unitySWpack.searchInUnityDocs": {
          "type": "boolean",
          "default": true,
          "description": "%config.searchInUnityDocs%"
        },
        "unitySWpack.unityEventLens": {
          "type": "boolean",
          "default": true,
          "description": "%config.unityEventLens%"
        },
        "unitySWpack.onlyScenesInBuildSettings": {
          "type": "boolean",
          "default": false,
          "description": "%config.onlyScenesInBuildSettings%"
        },
        "unitySWpack.debugLogging": {
          "type": "boolean",
          "default": false,
          "description": "%config.debugLogging%"
        }
      }
    },
    "themes": [
      {
        "label": "%theme.dark%",
        "uiTheme": "vs-dark",
        "path": "./theme/unity-sw-theme.json"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "unitySWpack.showEventReferences",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "unitySWpack.searchInUnityDocumentation",
          "when": "editorHasSelection == true",
          "group": "Unity SW Pack"
        }
      ]
    },
    "commands": [
      {
        "command": "unitySWpack.searchInUnityDocumentation",
        "title": "%cmd.searchDocs%"
      },
      {
        "command": "unitySWpack.changeReturnType",
        "title": "%cmd.changeCoroutine%"
      },
      {
        "command": "unitySWpack.showEventReferences",
        "title": "%cmd.showEventReferences%"
      }
    ],
    "keybindings": [
      {
        "command": "unitySWpack.searchInUnityDocumentation",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "editorHasSelection == true"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "clean": "rimraf out dist",
    "compile": "npm run clean && tsc -p ./",
    "bundle": "node esbuild.mjs",
    "package": "npm run clean && tsc -p ./ && node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "npm run compile && mocha --ui tdd \"out/test/suite/**/*.test.js\" --ignore \"out/test/suite/extension.test.js\"",
    "pretest": "npm run compile && npm run bundle && npm run lint",
    "test": "vscode-test",
    "vsix": "vsce package --no-dependencies",
    "build": "npm run compile && npm run bundle"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/js-yaml": "^4.0.5",
    "@types/mocha": "^10.0.1",
    "@types/node": "^16.18.23",
    "@types/vscode": "^1.76.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "mocha": "^10.2.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^4.9.5",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "l10n": "./l10n"
}
