// The default build task type-checks with tsc and then bundles with esbuild,
// so F5 always launches the same dist/ output the VSIX ships.
{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "build",
      "problemMatcher": ["$tsc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "type": "npm",
      "script": "watch",
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      }
    }
  ]
}
